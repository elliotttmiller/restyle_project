# Django Configuration
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
POSTGRES_DB=restyle_db
POSTGRES_USER=restyle_user
POSTGRES_PASSWORD=changeme

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Google Cloud Configuration
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
AWS_REGION_NAME=us-east-1

# eBay API Configuration
EBAY_PRODUCTION_APP_ID=your_ebay_app_id
EBAY_PRODUCTION_CERT_ID=your_ebay_cert_id
EBAY_PRODUCTION_CLIENT_SECRET=your_ebay_client_secret
EBAY_PRODUCTION_REFRESH_TOKEN=your_ebay_refresh_token

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS Settings (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
